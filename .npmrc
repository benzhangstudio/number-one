# Wispbyte runs `npm install` on every restart. If npm rewrote package-lock.json there, the next
# `git pull` would refuse to update. So npm neither reads nor writes the lockfile; versions come
# from the ranges in package.json.
package-lock=false

# Skip devDependencies (TypeScript, type definitions, drizzle-kit, tsx) on the server to save disk space:
# the build doesn't need them. On your own computer, run `npm install --include=dev` to get them.
omit=dev
